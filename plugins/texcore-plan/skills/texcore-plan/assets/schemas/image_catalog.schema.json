{"$schema": "http://json-schema.org/draft-07/schema#", "title": "image_catalog (texcore-plan)", "type": "object", "required": ["images"],
 "properties": {"images": {"type": "array", "items": {"type": "object",
   "required": ["file", "origin", "description", "kind", "suggested_slots", "quality", "evidence_value"],
   "properties": {"file": {"type": "string"}, "origin": {"type": "string"}, "w": {"type": "integer"}, "h": {"type": "integer"},
     "description": {"type": "string", "minLength": 5},
     "kind": {"enum": ["product", "prototype", "experiment", "screen", "chart", "photo", "logo", "cert", "patent", "paper", "table", "diagram", "team", "other"]},
     "suggested_slots": {"type": "array", "items": {"type": "string"}},
     "evidence_value": {"enum": ["high", "mid", "low"]},
     "proves": {"type": "string"},
     "has_korean_text": {"type": "boolean"}, "quality": {"enum": ["ok", "low"]}}}}}}

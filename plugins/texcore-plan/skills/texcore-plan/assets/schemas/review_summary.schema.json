{"$schema": "http://json-schema.org/draft-07/schema#", "title": "review_summary (texcore-plan)", "type": "object",
 "required": ["scores", "item_scores", "section_check", "issues", "judge_opinion", "attack_questions", "to_reach_85"],
 "properties": {
   "scores": {"type": "object", "required": ["vc", "tlo", "domain", "icorps", "layman", "avg"],
     "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}},
   "item_scores": {"type": "object", "required": ["아이템", "핵심기술", "사업화", "팀", "참여의지", "total"],
     "properties": {"아이템": {"type": "number", "maximum": 20}, "핵심기술": {"type": "number", "maximum": 15}, "사업화": {"type": "number", "maximum": 25},
                    "팀": {"type": "number", "maximum": 20}, "참여의지": {"type": "number", "maximum": 20}, "total": {"type": "number", "maximum": 100}}},
   "pf": {"type": "object", "properties": {"english": {"enum": ["P", "F", "N/A"]}, "us_market": {"enum": ["P", "F", "N/A"]}, "reason": {"type": "string"}}},
   "section_check": {"type": "array", "minItems": 8, "items": {"type": "object", "required": ["section_id", "verdict", "reason"],
     "properties": {"section_id": {"type": "string"}, "verdict": {"enum": ["O", "△", "X"]}, "reason": {"type": "string"}}}},
   "issues": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "section_id", "text", "fix_hint", "status"],
     "properties": {"id": {"type": "string"}, "severity": {"enum": ["critical", "major", "minor"]}, "section_id": {"type": "string"},
       "text": {"type": "string"}, "fix_hint": {"type": "string"}, "status": {"enum": ["open", "resolved", "accepted"]}, "resolution": {"type": "string"}}}},
   "judge_opinion": {"type": "object", "required": ["strengths", "weaknesses", "improvements", "questions"],
     "properties": {"strengths": {"type": "array", "items": {"type": "string"}}, "weaknesses": {"type": "array", "items": {"type": "string"}},
                    "improvements": {"type": "array", "items": {"type": "string"}}, "questions": {"type": "array", "items": {"type": "string"}}}},
   "attack_questions": {"type": "array", "minItems": 10, "maxItems": 20, "items": {"type": "string"}},
   "readability": {"type": "object", "properties": {"jargon_terms": {"type": "array", "items": {"type": "string"}}, "long_sentences": {"type": "integer"}, "verdict": {"type": "string"}}},
   "to_reach_85": {"type": "array", "items": {"type": "string"}}}}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fact_pack (texcore-plan)",
  "type": "object",
  "required": ["team", "people", "slots", "ip", "gaps", "contact"],
  "properties": {
    "team": {"type": "object", "required": ["name_ko", "item_ko", "edu_type"], "properties": {
      "name_ko": {"type": "string"}, "name_en": {"type": "string"}, "item_ko": {"type": "string"}, "item_en": {"type": "string"},
      "edu_type": {"enum": ["해외", "국내", "미정"]}, "region": {"type": "string"}, "special": {"type": "string"},
      "org": {"type": "string"}, "org_type": {"type": "string"}, "address": {"type": "string"},
      "tech_field": {"type": "string"}, "industry": {"type": "string"}, "one_liner": {"type": "string"}}},
    "people": {"type": "object", "required": ["EL", "PM", "PI", "EM"], "properties": {
      "EL": {"$ref": "#/definitions/person"}, "PM": {"$ref": "#/definitions/person"}, "PI": {"$ref": "#/definitions/person"},
      "EM": {"type": "array", "items": {"$ref": "#/definitions/person"}}}},
    "slots": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"type": "object",
      "required": ["slot_id", "name", "facts", "images", "status"],
      "properties": {
        "slot_id": {"enum": ["I-1", "I-2a", "I-2b", "I-2c", "I-2d", "II-1", "II-2a", "II-2b", "III-1", "III-2", "III-3", "IV", "EN"]},
        "name": {"type": "string"},
        "facts": {"type": "array", "items": {"type": "object", "required": ["text", "source"],
          "properties": {"text": {"type": "string", "minLength": 2}, "source": {"type": "string", "minLength": 2}, "asof": {"type": "string"}}}},
        "images": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["sufficient", "partial", "missing"]},
        "note": {"type": "string"}}}},
    "ip": {"type": "object", "required": ["patents", "other", "relations", "trl"], "properties": {
      "patents": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {
        "name": {"type": "string"}, "filed_year": {"type": "string"}, "filed_country": {"type": "string"}, "filed_no": {"type": "string"},
        "applicant": {"type": "string"}, "reg_year": {"type": "string"}, "reg_country": {"type": "string"}, "reg_no": {"type": "string"},
        "holder": {"type": "string"}, "inventors": {"type": "string"}, "source": {"type": "string"}}}},
      "other": {"type": "array", "items": {"type": "object", "properties": {
        "kind": {"type": "string"}, "title": {"type": "string"}, "reg_year": {"type": "string"}, "holder": {"type": "string"}, "reg_no": {"type": "string"}, "source": {"type": "string"}}}},
      "relations": {"type": "array", "items": {"type": "object", "properties": {
        "kind": {"type": "string"}, "title": {"type": "string"}, "number": {"type": "string"}, "holder": {"type": "string"},
        "inventor": {"type": "string"}, "relation": {"type": "string"}}}},
      "trl": {"type": "object", "properties": {"level": {"type": ["integer", "null"], "minimum": 1, "maximum": 9}, "evidence": {"type": "string"}, "source": {"type": "string"}}}}},
    "gaps": {"type": "array", "items": {"type": "object", "required": ["item", "why_needed", "slot_ids", "question_to_team"],
      "properties": {"item": {"type": "string"}, "why_needed": {"type": "string"}, "slot_ids": {"type": "array", "items": {"type": "string"}},
                     "question_to_team": {"type": "string"}, "priority": {"enum": ["high", "mid", "low"]}}}},
    "contact": {"type": "object", "properties": {"name": {"type": "string"}, "email": {"type": "string"}, "phone": {"type": "string"}}}
  },
  "definitions": {
    "person": {"type": "object", "properties": {
      "name": {"type": "string"}, "birth": {"type": "string"}, "org_dept": {"type": "string"}, "major": {"type": "string"},
      "degree_status": {"type": "string"}, "tel": {"type": "string"}, "phone": {"type": "string"}, "email": {"type": "string"},
      "relation_to_el": {"type": "string"}, "gender": {"type": "string"}, "career": {"type": "string"}, "duty": {"type": "string"},
      "source": {"type": "string"}}}
  }
}
